TENANT_ID=9070ef23-9a31-45a8-9b14-45111a4ebbbe
CLIENT_ID=3e16daef-f2ac-4761-86eb-2d80e04d9a7a
# Set a current secret locally. Never commit or paste it into logs.
CLIENT_SECRET=
MAILBOX=phishing@rededucation.com
POLL_SECONDS=60
MAX_MESSAGE_BYTES=26214400
# preview stores responses without sending; send activates delivery.
AUTO_REPLY_MODE=preview
ESCALATION_EMAIL=security@rededucation.com
# Exact domains allowed for reporting senders. Attached original senders are never recipients.
REPORTER_DOMAINS=rededucation.com
REPLIES_PER_HOUR=10

# Optional AI analysis. Use a billed OpenAI API key, never a ChatGPT session token.
# Relevant email content is sent to OpenAI when enabled; see README data controls.
AI_ANALYSIS_MODE=off
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MAX_INPUT_CHARS=20000
AI_MAX_OUTPUT_TOKENS=1200
# Daily attempt limit across this evidence volume, reset at UTC midnight.
AI_DAILY_LIMIT=100
AI_TIMEOUT_SECONDS=25

# Dedicated bridge; confirm no corporate/VPN/Docker overlap before deployment.
# Change both together; changing these requires network recreation (see README).
ANALYZER_NETWORK_SUBNET=192.168.251.0/28
ANALYZER_NETWORK_GATEWAY=192.168.251.1
